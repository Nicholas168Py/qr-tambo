# QR Tambo - SPA fallback (React Router) + Cache Control
# Rewrites all non-file/non-directory requests to index.html
RewriteEngine On
RewriteBase /qr_tambo/frontend/dist/

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /qr_tambo/frontend/dist/index.html [L]

# Prevent caching of index.html (critical for mobile/SPA updates)
<Files "index.html">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Expires "0"
        Header set Pragma "no-cache"
    </IfModule>
</Files>

# Long cache for hashed assets (JS/CSS/images) - safe because filenames change on each build
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</FilesMatch>
